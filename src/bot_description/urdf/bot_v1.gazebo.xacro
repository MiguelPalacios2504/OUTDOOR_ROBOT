<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bot_v1">
  <xacro:arg name="mesh_dir" default="package://bot_description/meshes" />
  <xacro:arg name="controllers_file" default="" />
  <xacro:arg name="imu_update_rate" default="100.0" />
  <xacro:arg name="use_lidar" default="false" />
  <xacro:arg name="use_camera" default="false" />
  <xacro:arg name="use_gnss" default="false" />
  <xacro:arg name="gnss_topic" default="/gnss/fix" />
  <xacro:arg name="gnss_frame_id" default="gnss_link" />
  <xacro:arg name="gnss_update_rate" default="10.0" />
  <xacro:arg name="gnss_xyz" default="0 0 0.18" />
  <xacro:arg name="gnss_size_xyz" default="0.04 0.04 0.02" />
  <xacro:arg name="gnss_mass" default="0.05" />
  <!-- Unitree 4D-LiDAR L2 (see config/unitree_4d_lidar_l2.yaml) -->
  <xacro:arg name="lidar_topic" default="/lidar" />
  <xacro:arg name="lidar_xyz" default="0 0 0.20" />
  <xacro:arg name="lidar_frame_id" default="lidar_link" />
  <xacro:arg name="lidar_update_rate" default="5.55" />
  <xacro:arg name="lidar_horizontal_samples" default="591" />
  <xacro:arg name="lidar_vertical_samples" default="39" />
  <xacro:arg name="lidar_min_range" default="0.05" />
  <xacro:arg name="lidar_max_range" default="30.0" />
  <xacro:arg name="lidar_range_resolution" default="0.0045" />
  <xacro:arg name="lidar_noise_stddev" default="0.02" />
  <xacro:arg name="lidar_size_xyz" default="0.075 0.075 0.065" />
  <xacro:arg name="lidar_mass" default="0.23" />

  <xacro:include filename="bot_v1.core.xacro" />
  <xacro:include filename="bot_v1.lidar.xacro" />
  <xacro:include filename="bot_v1.camera.xacro" />
  <xacro:include filename="bot_v1.gnss.xacro" />

  <xacro:macro name="ros2_control_position_joint" params="joint_name">
    <joint name="${joint_name}">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </xacro:macro>

  <xacro:macro name="ros2_control_velocity_joint" params="joint_name">
    <joint name="${joint_name}">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </xacro:macro>

  <xacro:bot_robot mesh_dir="$(arg mesh_dir)" />

  <xacro:if value="$(arg use_lidar)">
    <xacro:bot_lidar
      add_gazebo="true"
      xyz="$(arg lidar_xyz)"
      topic="$(arg lidar_topic)"
      frame_id="$(arg lidar_frame_id)"
      update_rate="$(arg lidar_update_rate)"
      horizontal_samples="$(arg lidar_horizontal_samples)"
      vertical_samples="$(arg lidar_vertical_samples)"
      min_range="$(arg lidar_min_range)"
      max_range="$(arg lidar_max_range)"
      range_resolution="$(arg lidar_range_resolution)"
      noise_stddev="$(arg lidar_noise_stddev)"
      size_xyz="$(arg lidar_size_xyz)"
      mass="$(arg lidar_mass)" />
  </xacro:if>

  <xacro:if value="$(arg use_camera)">
    <xacro:bot_camera add_gazebo="true" />
  </xacro:if>

  <xacro:if value="$(arg use_gnss)">
    <xacro:bot_gnss
      add_gazebo="true"
      topic="$(arg gnss_topic)"
      frame_id="$(arg gnss_frame_id)"
      update_rate="$(arg gnss_update_rate)"
      xyz="$(arg gnss_xyz)"
      size_xyz="$(arg gnss_size_xyz)"
      mass="$(arg gnss_mass)" />
  </xacro:if>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>$(arg imu_update_rate)</update_rate>
      <topic>/imu/data</topic>
    </sensor>
  </gazebo>

  <ros2_control name="bot_gazebo_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <xacro:ros2_control_position_joint joint_name="f_left_steer" />
    <xacro:ros2_control_position_joint joint_name="f_right_steer" />
    <xacro:ros2_control_position_joint joint_name="b_leftsteer" />
    <xacro:ros2_control_position_joint joint_name="b_rightsteer" />

    <xacro:ros2_control_velocity_joint joint_name="f_leftwheel" />
    <xacro:ros2_control_velocity_joint joint_name="f_rightwheel" />
    <xacro:ros2_control_velocity_joint joint_name="b_leftwheel" />
    <xacro:ros2_control_velocity_joint joint_name="b_rightwheel" />
  </ros2_control>

  <gazebo>
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>2</dimensions>
      <odom_frame>ground_truth</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/ground_truth/odom</odom_topic>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>

    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <ros>
        <namespace>/</namespace>
      </ros>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <controller_manager_name>controller_manager</controller_manager_name>
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>
</robot>
