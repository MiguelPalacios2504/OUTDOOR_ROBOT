<?xml version="1.0" encoding="utf-8"?>
<!-- Simulated GNSS antenna (Gazebo type="navsat" -> sensor_msgs/NavSatFix). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro
    name="bot_gnss"
    params="
      parent:=chassis_link
      xyz:='0 0 0.12'
      rpy:='0 0 0'
      add_gazebo:=false
      topic:=/gnss/fix
      frame_id:=gnss_link
      update_rate:=10.0
      size_xyz:='0.04 0.04 0.02'
      mass:=0.05">

    <link name="${frame_id}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="${mass}" />
        <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5" />
      </inertial>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${size_xyz}" />
        </geometry>
        <material name="gnss_antenna_green">
          <color rgba="0.1 0.55 0.2 1.0" />
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${size_xyz}" />
        </geometry>
      </collision>
    </link>

    <joint name="gnss_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="${parent}" />
      <child link="${frame_id}" />
    </joint>

    <xacro:if value="${add_gazebo}">
      <gazebo reference="${frame_id}">
        <sensor name="gnss_sensor" type="navsat">
          <always_on>1</always_on>
          <update_rate>${update_rate}</update_rate>
          <topic>${topic}</topic>
          <gz_frame_id>${frame_id}</gz_frame_id>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
