<?xml version="1.0" encoding="utf-8"?>
<!-- Unitree 4D-LiDAR L2 — defaults match config/unitree_4d_lidar_l2.yaml (datasheet). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro
    name="bot_lidar"
    params="
      parent:=chassis_link
      xyz:='0 0 0.17'
      rpy:='0 0 0'
      add_gazebo:=false
      topic:=/lidar
      frame_id:=lidar_link
      update_rate:=5.55
      horizontal_samples:=591
      vertical_samples:=39
      min_angle:=-3.141592653589793
      max_angle:=3.141592653589793
      vertical_min_angle:=-0.13962634015954636
      vertical_max_angle:=1.5707963267948966
      min_range:=0.05
      max_range:=30.0
      range_resolution:=0.0045
      noise_stddev:=0.02
      size_xyz:='0.075 0.075 0.065'
      mass:=0.23">

    <link name="${frame_id}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="${mass}" />
        <inertia ixx="2e-4" ixy="0.0" ixz="0.0" iyy="2e-4" iyz="0.0" izz="2e-4" />
      </inertial>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${size_xyz}" />
        </geometry>
        <material name="unitree_l2_gray">
          <color rgba="0.12 0.12 0.12 1.0" />
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${size_xyz}" />
        </geometry>
      </collision>
    </link>

    <joint name="lidar_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="${parent}" />
      <child link="${frame_id}" />
    </joint>

    <xacro:if value="${add_gazebo}">
      <!-- SDFormat <sensor type="gpu_lidar">: scan/range/noise under <lidar> only.
           Mount pose is the URDF joint; sensor pose is identity on ${frame_id}.
           Harmonic (not in SDFormat spec): frame_id + gz_frame_id for ros_gz_bridge headers. -->
      <gazebo reference="${frame_id}">
        <sensor name="unitree_4d_lidar_l2" type="gpu_lidar">
          <always_on>true</always_on>
          <update_rate>${update_rate}</update_rate>
          <topic>${topic}</topic>
          <pose>0 0 0 0 0 0</pose>
          <frame_id>${frame_id}</frame_id>
          <gz_frame_id>${frame_id}</gz_frame_id>
          <lidar>
            <scan>
              <horizontal>
                <samples>${horizontal_samples}</samples>
                <resolution>1</resolution>
                <min_angle>${min_angle}</min_angle>
                <max_angle>${max_angle}</max_angle>
              </horizontal>
              <vertical>
                <samples>${vertical_samples}</samples>
                <resolution>1</resolution>
                <min_angle>${vertical_min_angle}</min_angle>
                <max_angle>${vertical_max_angle}</max_angle>
              </vertical>
            </scan>
            <range>
              <min>${min_range}</min>
              <max>${max_range}</max>
              <resolution>${range_resolution}</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>${noise_stddev}</stddev>
            </noise>
          </lidar>
          <visualize>false</visualize>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
