Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Source: Topic
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/PointCloud2
      Name: LIO-SAM Map
      Enabled: true
      Topic:
        Value: /lio_sam/mapping/map_global
        Depth: 5
        Reliability Policy: Best Effort
      Size (m): 0.05
      Color Transformer: Intensity
    - Class: rviz_default_plugins/PointCloud2
      Name: Deskewed Scan
      Enabled: true
      Topic:
        Value: /lio_sam/deskew/cloud_deskewed
        Depth: 5
        Reliability Policy: Best Effort
      Size (m): 0.03
    - Class: rviz_default_plugins/Odometry
      Name: LIO-SAM Odom
      Enabled: true
      Topic:
        Value: /lio_sam/mapping/odometry
        Depth: 5
  Global Options:
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.5
      Yaw: 0.8
