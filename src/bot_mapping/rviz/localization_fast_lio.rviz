Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Displays:
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Saved Map
      Size (m): 0.05
      Topic:
        Value: /map
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Live Scan
      Color: 0; 255; 0
      Size (m): 0.08
      Topic:
        Value: /cloud_registered
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Scan In Map
      Color: 255; 255; 0
      Size (m): 0.08
      Topic:
        Value: /cur_scan_in_map
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Localization
      Topic:
        Value: /localization
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Path
      Topic:
        Value: /path
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/MoveCamera
  Value: true
